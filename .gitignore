# Segredos locais nunca devem entrar no repositório.
.env
.env.*
!.env.example

# Backups gerados localmente não fazem parte da fonte versionada.
*.bak
*.backup
*.orig

# Ambiente Python e pesos de modelos são provisionados localmente e não fazem parte da fonte.
.venv/
models/

# Bytecode gerado localmente não faz parte da fonte versionada.
__pycache__/
*.pyc
*.pyo

# Pastas descartáveis criadas pelos testes dentro do repositório, nunca fazem parte da fonte versionada.
tmp-*/
